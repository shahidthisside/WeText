# Copy to apps/server/.env if you like, or set these in your host's dashboard.
# Every value is optional for local development.

# Where data lives. Local file path in development; a Turso URL in production.
#DATABASE_URL=libsql://your-db-name-your-org.turso.io
#DATABASE_AUTH_TOKEN=

# Public address of the site, used in emailed links. Required in production.
#PUBLIC_URL=https://wetext.onrender.com

# Password-reset emails through Brevo's free plan (https://www.brevo.com).
#BREVO_API_KEY=
#MAIL_FROM=you@example.com
#MAIL_FROM_NAME=WeText

# The one account allowed to read submitted reports via GET /api/admin/reports.
# Set it to your own username to review reports as the site owner. Leave unset to disable the
# endpoint entirely (it then returns 404 for everyone).
#ADMIN_USERNAME=

# Relay for calls that cannot connect directly. The Jami project's public relay is used by default; turn it off with:
#JAMI_RELAY=off
# Optional extra relays of your own, tried before Jami.
# Metered (sign-up needed): the address that returns your connection servers.
#TURN_API_URL=https://YOURAPP.metered.live/api/v1/turn/credentials?apiKey=YOUR_KEY
# ...or a relay with a fixed login:
#TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443
#TURN_USERNAME=
#TURN_CREDENTIAL=

#PORT=4000
#HOST=127.0.0.1
