# Copy to apps/server/.env if you like, or set these in your host's dashboard.
# Every value is optional for local development.

# Where data lives. Local file path in development; a Turso URL in production.
#DATABASE_URL=libsql://your-db-name-your-org.turso.io
#DATABASE_AUTH_TOKEN=

# Public address of the site, used in emailed links. Required in production.
#PUBLIC_URL=https://wetext.onrender.com

# Password-reset emails through Brevo's free plan (https://www.brevo.com).
#BREVO_API_KEY=
#MAIL_FROM=you@example.com
#MAIL_FROM_NAME=WeText

#PORT=4000
#HOST=127.0.0.1
